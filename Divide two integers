class Solution {
    public int divide(int dividend, int divisor) {
        // Handle overflow edge case: -2^31 / -1 = 2^31, which exceeds 32-bit signed int max (2^31 - 1)
        if (dividend == Integer.MIN_VALUE && divisor == -1) {
            return Integer.MAX_VALUE;
        }

        // Determine sign of the result
        boolean negative = (dividend < 0) ^ (divisor < 0);

        // Convert numbers to negative values to avoid integer overflow when taking abs(Integer.MIN_VALUE)
        int a = dividend < 0 ? dividend : -dividend;
        int b = divisor < 0 ? divisor : -divisor;

        int quotient = 0;

        // Perform bitwise division
        while (a <= b) {
            int temp = b;
            int multiple = 1;

            // Double the divisor estimate as much as possible without overflowing
            while (temp >= Integer.MIN_VALUE >> 1 && a <= (temp << 1)) {
                temp <<= 1;
                multiple <<= 1;
            }

            a -= temp;
            quotient += multiple;
        }

        return negative ? -quotient : quotient;
    }
}
