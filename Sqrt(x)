class Solution {
    public int mySqrt(int x) {
        if (x < 2) {
            return x;
        }

        int left = 1;
        int right = x / 2;
        int ans = 0;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            // Use division (mid <= x / mid) to prevent integer overflow
            if (mid <= x / mid) {
                ans = mid;
                left = mid + 1; // Try to find a larger valid integer
            } else {
                right = mid - 1; // Value is too large, search left half
            }
        }

        return ans;
    }
}
